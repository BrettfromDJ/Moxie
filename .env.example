# Required: Claude API key
ANTHROPIC_API_KEY=

# Optional: OpenAI models. When set, the composer shows a model picker so you
# can write with OpenAI instead of Claude.
OPENAI_API_KEY=
# MOXIE_OPENAI_MODEL=gpt-6-astra
# MOXIE_OPENAI_FAST_MODEL=         (for Fit to X, Shorten; defaults to the main model)
# MOXIE_OPENAI_REASONING=          (low | medium | high, for reasoning models)

# Optional: enables "Connect X" onboarding and richer X post retrieval
# (full text of long posts and parent-post relationships)
X_BEARER_TOKEN=

# Optional: per-job model and effort overrides (low | medium | high | xhigh | max)
# MOXIE_WRITER_MODEL=claude-opus-5
# MOXIE_WRITER_EFFORT=medium
# MOXIE_ANALYZE_MODEL=claude-opus-5
# MOXIE_ANALYZE_EFFORT=high
# MOXIE_FAST_MODEL=claude-opus-5
# MOXIE_FAST_EFFORT=low

# Optional: canned responses so the UI works without an API key
# MOXIE_MOCK=1
